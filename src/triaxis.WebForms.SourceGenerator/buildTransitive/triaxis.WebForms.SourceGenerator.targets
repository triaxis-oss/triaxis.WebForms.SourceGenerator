<Project>

  <PropertyGroup>
    <!-- At publish, replace each markup and handler file with a zero-byte
         placeholder: BuildManager only probes for existence once .compiled
         sidecars put the app in non-updatable precompiled mode, so the
         deployment needs neither the markup source nor the handler
         directives (which would otherwise leak internal type names already
         carried, where needed, in the sidecars). Opt out with
         WebFormsGenStripPublishedMarkup=false. -->
    <WebFormsGenStripPublishedMarkup Condition=" '$(WebFormsGenStripPublishedMarkup)' == '' ">true</WebFormsGenStripPublishedMarkup>
    <!-- Path-prefix the .compiled sidecars are added to ResolvedFileToPublish
         under, relative to $(PublishDir). Leave empty when
         WebFormsGenBinariesInBin is on (default) — the binaries-to-bin
         move below relocates the dll, pdb, deps json AND the .compiled
         sidecars in one shot. Consumers that disable the move (because
         they already have an equivalent pipeline) typically set this to
         `bin\` so the .compiled files still land where BuildManager
         probes. Trailing path separator required when non-empty. -->
    <WebFormsGenPublishCompiledRelativePath Condition=" '$(WebFormsGenPublishCompiledRelativePath)' == '' "></WebFormsGenPublishCompiledRelativePath>
    <!-- After Publish file-list computation, move every non-content
         item (host assembly, its pdb, deps json, our .compiled sidecars,
         …) under PublishDir/bin/ to match the ASP.NET WebForms
         deployment layout. Web content (aspx/ascx/master, web.config,
         PrecompiledApp.config, images, scripts) stays at the publish
         root. Disable when the consumer has an equivalent step. -->
    <WebFormsGenBinariesInBin Condition=" '$(WebFormsGenBinariesInBin)' == '' ">true</WebFormsGenBinariesInBin>
    <!-- Semicolon-separated list of filenames (e.g. "WinSCP.exe;Foo.dll")
         that should be reclassified as binaries — moved to bin/ — even
         when the SDK's content pipeline carries them as web content.
         Match is by exact filename+extension; case-sensitive. Typical
         use: native helpers shipped alongside the app that the WebForms
         runtime expects in bin/. -->
    <WebFormsGenAdditionalBinaries Condition=" '$(WebFormsGenAdditionalBinaries)' == '' "></WebFormsGenAdditionalBinaries>
    <!-- After Publish, XDT-apply web.$(Configuration).config (e.g.
         web.Release.config / web.Debug.config) onto the published
         web.config. Uses the TransformXml MSBuild task registered by
         Microsoft.NET.Sdk.Publish, which is loaded for any project
         running dotnet publish. -->
    <WebFormsGenTransformConfig Condition=" '$(WebFormsGenTransformConfig)' == '' ">true</WebFormsGenTransformConfig>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="MSBuildProjectDirectory" />
  </ItemGroup>

  <!-- BuildManager only enters precompiled mode when PrecompiledApp.config
       sits at the web root (next to web.config). Without it, the .compiled
       sidecars below are ignored and aspx pages get JIT-compiled at request
       time — which on Linux silently fails. Fail the build early with a
       copy-pasteable fix; the marker is a one-line config that belongs in
       source control alongside web.config. -->
  <Target Name="_WebFormsGenCheckPrecompiledAppConfig" BeforeTargets="Build"
          Condition=" '$(WebFormsGenCheckPrecompiledAppConfig)' != 'false' AND !Exists('$(MSBuildProjectDirectory)\PrecompiledApp.config') ">
    <!-- Only nag when the project actually has markup that would emit
         .compiled sidecars — a library that pulls the package only for
         its content / publish pipeline (e.g. an .asmx-only service)
         needs no PrecompiledApp.config. -->
    <ItemGroup>
      <_WebFormsGenAnyMarkup Include="$(WebFormsGenMarkupInclude)" Exclude="$(WebFormsGenMarkupExclude)" />
    </ItemGroup>
    <Error Code="TWF001"
           Condition=" '@(_WebFormsGenAnyMarkup)' != '' "
           Text="PrecompiledApp.config is missing from the project root. The WebForms source generator requires it next to web.config so BuildManager enters precompiled mode. Create PrecompiledApp.config with this single line and commit it: &lt;precompiledApp version=&quot;2&quot; updatable=&quot;false&quot; /&gt;  Override with -p:WebFormsGenCheckPrecompiledAppConfig=false." />
  </Target>

  <!-- MSBuild tasks live in tasks/netstandard2.0/, compiled from
       src/triaxis.WebForms.MSBuildTasks/ and packed alongside the analyzer.
       Loading the dll once instead of building a Roslyn-RoslynCodeTaskFactory
       task inline per build avoids ~120 lines of unreviewable C# in XML. -->
  <UsingTask TaskName="triaxis.WebForms.MSBuildTasks.GenerateWebFormsCompiledFiles"
             AssemblyFile="$(MSBuildThisFileDirectory)..\tasks\netstandard2.0\triaxis.WebForms.MSBuildTasks.dll" />
  <UsingTask TaskName="triaxis.WebForms.MSBuildTasks.StripMarkupFiles"
             AssemblyFile="$(MSBuildThisFileDirectory)..\tasks\netstandard2.0\triaxis.WebForms.MSBuildTasks.dll" />

  <!-- The TransformXml MSBuild task ships only inside Microsoft.NET.Sdk.Publish,
       and a plain <Project Sdk="Microsoft.NET.Sdk"> doesn't auto-import that
       SDK on `dotnet publish`. Locate its task assembly under the SDK install
       and register the <UsingTask> ourselves. Skip when the SDK is already
       loaded (its own UsingTask is in scope), to avoid registering twice.
       The cascading fallbacks below cover .NET Framework MSBuild and the
       net{N}.0 layouts of recent SDKs — add a new line at the top if a
       newer SDK ships under a higher tfm. -->
  <PropertyGroup Condition=" '$(WebFormsGenTransformConfig)' == 'true' AND '$(_PublishTaskAssemblyFullPath)' == '' ">
    <_WebFormsGenSdkPublishTools>$(MSBuildSDKsPath)\Microsoft.NET.Sdk.Publish\tools\</_WebFormsGenSdkPublishTools>
    <_WebFormsGenPublishTaskAssembly Condition=" '$(MSBuildRuntimeType)' == 'Core' AND Exists('$(_WebFormsGenSdkPublishTools)net10.0\Microsoft.NET.Sdk.Publish.Tasks.dll') ">$(_WebFormsGenSdkPublishTools)net10.0\Microsoft.NET.Sdk.Publish.Tasks.dll</_WebFormsGenPublishTaskAssembly>
    <_WebFormsGenPublishTaskAssembly Condition=" '$(_WebFormsGenPublishTaskAssembly)' == '' AND '$(MSBuildRuntimeType)' == 'Core' AND Exists('$(_WebFormsGenSdkPublishTools)net9.0\Microsoft.NET.Sdk.Publish.Tasks.dll') ">$(_WebFormsGenSdkPublishTools)net9.0\Microsoft.NET.Sdk.Publish.Tasks.dll</_WebFormsGenPublishTaskAssembly>
    <_WebFormsGenPublishTaskAssembly Condition=" '$(_WebFormsGenPublishTaskAssembly)' == '' AND '$(MSBuildRuntimeType)' == 'Core' AND Exists('$(_WebFormsGenSdkPublishTools)net8.0\Microsoft.NET.Sdk.Publish.Tasks.dll') ">$(_WebFormsGenSdkPublishTools)net8.0\Microsoft.NET.Sdk.Publish.Tasks.dll</_WebFormsGenPublishTaskAssembly>
    <_WebFormsGenPublishTaskAssembly Condition=" '$(_WebFormsGenPublishTaskAssembly)' == '' AND Exists('$(_WebFormsGenSdkPublishTools)net472\Microsoft.NET.Sdk.Publish.Tasks.dll') ">$(_WebFormsGenSdkPublishTools)net472\Microsoft.NET.Sdk.Publish.Tasks.dll</_WebFormsGenPublishTaskAssembly>
  </PropertyGroup>
  <UsingTask TaskName="TransformXml"
             AssemblyFile="$(_WebFormsGenPublishTaskAssembly)"
             Condition=" '$(_WebFormsGenPublishTaskAssembly)' != '' " />

  <!-- Emit lean .compiled stubs pointing BuildManager at the Roslyn-generated
       ASP.* types in the main app assembly, replacing the
       aspnet_compiler / aspnet_merge precompile. -->
  <Target Name="_WebFormsGenGenerateCompiled" AfterTargets="Build">
    <!-- Same include/exclude as the generator's AdditionalFiles up top; the
         property hoist keeps these two consumers from drifting. -->
    <ItemGroup>
      <_WebFormsGenMarkupForCompiled Include="$(WebFormsGenMarkupInclude)"
                                 Exclude="$(WebFormsGenMarkupExclude)" />
      <!-- App_Browsers\*.browser drives the __browserCapabilitiesCompiler.compiled sidecar;
           passing an empty list when none exist suppresses the sidecar. -->
      <_WebFormsGenBrowserForCompiled Include="App_Browsers\**\*.browser" />
      <!-- Same App_Themes glob the generator consumes; the task reduces it to
           the distinct theme folders and writes one Theme_<name>.compiled each. -->
      <_WebFormsGenThemeForCompiled Include="$(WebFormsGenThemeInclude)" />
      <!-- .asmx/.ashx/.svc handlers each need a sidecar binding their virtual
           path to the prebuilt type named in the directive; the task resolves
           which built assembly holds that type (and, for .svc, the deployed
           closure) by reading the output dir. -->
      <_WebFormsGenHandlerForCompiled Include="$(WebFormsGenHandlerInclude)"
                                 Exclude="$(WebFormsGenHandlerExclude)" />
      <_WebFormsGenOutputAssemblies Include="$(OutDir)*.dll" />
    </ItemGroup>
    <triaxis.WebForms.MSBuildTasks.GenerateWebFormsCompiledFiles
        ProjectDir="$(MSBuildProjectDirectory)"
        OutputDir="$(OutDir)"
        AssemblyName="$(AssemblyName)"
        MarkupFiles="@(_WebFormsGenMarkupForCompiled)"
        BrowserFiles="@(_WebFormsGenBrowserForCompiled)"
        ThemeFiles="@(_WebFormsGenThemeForCompiled)"
        HandlerFiles="@(_WebFormsGenHandlerForCompiled)"
        ReferenceAssemblies="@(_WebFormsGenOutputAssemblies)" />
  </Target>

  <!-- The .compiled stubs above sit in $(OutDir) but aren't part of any
       built-in item group, so dotnet publish skips them. Add them to
       ResolvedFileToPublish; when WebFormsGenBinariesInBin is on the
       move target below picks them up alongside the dll/pdb/deps. -->
  <Target Name="_WebFormsGenAddCompiledToPublish"
          AfterTargets="ComputeResolvedFilesToPublishList"
          Condition=" '$(WebFormsGenPublishCompiled)' != 'false' ">
    <!-- Two-step on purpose: collect the .compiled glob into a fresh item
         list first, then transfer with metadata. A single-step
         `<ResolvedFileToPublish Include="$(OutDir)*.compiled"><RelativePath>%(Filename)%(Extension)…`
         cross-product-batches against the EXISTING ResolvedFileToPublish
         items (the metadata block batches against the target group, not the
         items being included), corrupting RelativePath. -->
    <ItemGroup>
      <_WebFormsGenCompiledForPublish Include="$(OutDir)*.compiled" />
      <ResolvedFileToPublish Include="@(_WebFormsGenCompiledForPublish)"
                             RelativePath="$(WebFormsGenPublishCompiledRelativePath)%(_WebFormsGenCompiledForPublish.Filename)%(_WebFormsGenCompiledForPublish.Extension)" />
    </ItemGroup>
  </Target>

  <!-- Move every non-content publish item under PublishDir/bin/ — the
       host assembly, its pdb, deps json, and our .compiled sidecars all
       go to bin/; everything that came in via the SDK's content pipeline
       (aspx/ascx/master, web.config, PrecompiledApp.config, images,
       scripts) stays at the publish root. Mirrors the
       MM_MoveBinariesToBinDirectory pattern, but packaged so consumers
       don't have to maintain it themselves. Runs AFTER
       _WebFormsGenAddCompiledToPublish so the .compiled entries are in the
       snapshot at split time. -->
  <Target Name="_WebFormsGenMoveBinariesToBin"
          AfterTargets="ComputeResolvedFilesToPublishList"
          DependsOnTargets="_WebFormsGenAddCompiledToPublish"
          Condition=" '$(WebFormsGenBinariesInBin)' == 'true' ">
    <PropertyGroup>
      <!-- Semicolon-bordered guard string so .Contains() can be used as
           a set membership test below: ";WinSCP.exe;Foo.dll;".Contains(';X;'). -->
      <_WebFormsGenAdditionalGuarded>;$(WebFormsGenAdditionalBinaries);</_WebFormsGenAdditionalGuarded>
    </PropertyGroup>
    <ItemGroup>
      <!-- Build the content set from the SDK's content publish list,
           dropping anything whose filename+extension is in
           $(WebFormsGenAdditionalBinaries). Dropped items then fall
           through to the binaries bucket below and get moved to bin/. -->
      <_WebFormsGenPublishedContent Include="@(AllPublishItemsFullPathWithTargetPath)"
          Condition=" !$(_WebFormsGenAdditionalGuarded.Contains(';%(Filename)%(Extension);')) " />
      <_WebFormsGenPublishedBinaries Include="@(ResolvedFileToPublish)" Exclude="@(_WebFormsGenPublishedContent)" />
      <ResolvedFileToPublish Remove="@(_WebFormsGenPublishedBinaries)" />
      <ResolvedFileToPublish Include="@(_WebFormsGenPublishedBinaries)" RelativePath="bin\%(RelativePath)" />
    </ItemGroup>
  </Target>

  <!-- After Publish, zero out each published markup and handler file. The
       page/handler type is already compiled into (or referenced by) the
       app; BuildManager and the WCF host resolve it from the .compiled
       sidecar and just need the file to exist. Empty placeholders keep the
       deployment small and keep both markup source and the handler
       directives' internal type names out of the artifact. -->
  <Target Name="_WebFormsGenStripPublishedMarkup" AfterTargets="Publish"
          Condition=" '$(WebFormsGenStripPublishedMarkup)' == 'true' ">
    <ItemGroup>
      <_WebFormsGenPublishedMarkup Include="$(PublishDir)**\*.aspx;$(PublishDir)**\*.ascx;$(PublishDir)**\*.master;$(PublishDir)**\*.asmx;$(PublishDir)**\*.ashx;$(PublishDir)**\*.svc" />
    </ItemGroup>
    <triaxis.WebForms.MSBuildTasks.StripMarkupFiles
        Files="@(_WebFormsGenPublishedMarkup)" />
  </Target>

  <!-- After Publish, XDT-transform the published web.config with the
       configuration-specific transform (web.Release.config /
       web.Debug.config / web.<Custom>.config) if it exists at the
       project root. The transform runs in place on the published
       web.config so the original source web.config is unchanged. -->
  <Target Name="_WebFormsGenTransformWebConfig" AfterTargets="Publish"
          Condition=" '$(WebFormsGenTransformConfig)' == 'true' AND Exists('$(MSBuildProjectDirectory)\web.$(Configuration).config') AND Exists('$(PublishDir)web.config') ">
    <!-- TransformXml is registered by Microsoft.NET.Sdk.Publish, which is
         loaded by the publish target tree before AfterTargets="Publish"
         fires, so no <UsingTask> is needed here. -->
    <TransformXml Source="$(PublishDir)web.config"
                  Transform="$(MSBuildProjectDirectory)\web.$(Configuration).config"
                  Destination="$(PublishDir)web.config" />
  </Target>

</Project>
