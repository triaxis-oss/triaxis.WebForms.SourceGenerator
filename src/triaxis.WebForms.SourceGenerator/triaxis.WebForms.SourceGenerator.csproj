<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- Analyzer-only package: ships the analyzer dll under analyzers/ plus
         a buildTransitive targets file plus the MSBuild task dll under
         tasks/. No runtime lib/ content, no flowed dependencies. -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <DevelopmentDependency>true</DevelopmentDependency>
    <!-- IncludeBuildOutput=false would leave the snupkg empty (no lib/ pdb),
         which trips NU5017. The analyzer dll's symbols ship inside the
         analyzer payload below, not as a separate snupkg. -->
    <IncludeSymbols>false</IncludeSymbols>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_AddAnalyzerToPackage</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <!-- ProjectReference (not PackageReference) so the tasks dll is built
         before our pack target runs; ReferenceOutputAssembly=false because
         the analyzer has no compile-time dependency on the tasks classes. -->
    <ProjectReference Include="..\triaxis.WebForms.MSBuildTasks\triaxis.WebForms.MSBuildTasks.csproj"
                      PrivateAssets="all" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="triaxis.WebForms.SourceGenerator.Tests" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

  <ItemGroup>
    <None Include="buildTransitive\$(PackageId).targets"
          Pack="true" PackagePath="buildTransitive" Visible="false" />
    <None Include="..\..\LICENSE.txt" Pack="true" PackagePath="$(PackageLicenseFile)" Visible="false" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <Target Name="_AddAnalyzerToPackage">
    <PropertyGroup>
      <_TriaxisTasksBuildOutput>$(MSBuildThisFileDirectory)..\triaxis.WebForms.MSBuildTasks\bin\$(Configuration)\netstandard2.0\</_TriaxisTasksBuildOutput>
    </PropertyGroup>
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(OutputPath)$(AssemblyName).dll" PackagePath="analyzers/dotnet/cs" />
      <TfmSpecificPackageFile Include="$(OutputPath)$(AssemblyName).pdb" PackagePath="analyzers/dotnet/cs"
                              Condition=" Exists('$(OutputPath)$(AssemblyName).pdb') " />
      <!-- buildTransitive/<id>.targets references this dll by relative path
           ($(MSBuildThisFileDirectory)../tasks/netstandard2.0/...). -->
      <TfmSpecificPackageFile Include="$(_TriaxisTasksBuildOutput)triaxis.WebForms.MSBuildTasks.dll"
                              PackagePath="tasks/netstandard2.0" />
      <TfmSpecificPackageFile Include="$(_TriaxisTasksBuildOutput)triaxis.WebForms.MSBuildTasks.pdb"
                              PackagePath="tasks/netstandard2.0"
                              Condition=" Exists('$(_TriaxisTasksBuildOutput)triaxis.WebForms.MSBuildTasks.pdb') " />
    </ItemGroup>
  </Target>

</Project>
