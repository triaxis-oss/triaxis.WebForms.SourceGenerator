<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <!-- MSBuild task assembly hosted by the consumer's MSBuild at build
         time. Don't pack as its own NuGet — the analyzer csproj picks it
         up via TfmSpecificPackageFile and puts it under tasks/. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- MSBuild already loads Microsoft.Build.Utilities.Core into its host;
         we just need the metadata reference, not a runtime ship. -->
    <PackageReference Include="Microsoft.Build.Utilities.Core" PrivateAssets="all" ExcludeAssets="runtime" />
    <!-- Reading type/assembly metadata out of the build outputs binds a
         handler to its prebuilt type's assembly. Provided at runtime by the
         MSBuild host (the .NET shared framework / MSBuild bin), so reference
         it metadata-only like the build utilities above. -->
    <PackageReference Include="System.Reflection.Metadata" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="System.Collections.Immutable" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="triaxis.WebForms.SourceGenerator.Tests" />
  </ItemGroup>

</Project>
