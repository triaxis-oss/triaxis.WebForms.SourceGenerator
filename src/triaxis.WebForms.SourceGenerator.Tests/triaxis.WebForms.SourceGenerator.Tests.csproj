    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <ProjectReference Include="..\triaxis.WebForms.SourceGenerator\triaxis.WebForms.SourceGenerator.csproj" />
    <ProjectReference Include="..\triaxis.WebForms.MSBuildTasks\triaxis.WebForms.MSBuildTasks.csproj" />
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
